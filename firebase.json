{
  "firestore": [
    {
      "database": "ai-studio-alphaengine-94d6c309-5a24-4eb3-b5fc-aed88e51a000",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "site": "alpha-engine-ai-studio",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

